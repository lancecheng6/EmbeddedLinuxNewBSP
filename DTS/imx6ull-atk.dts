// SPDX-License-Identifier: (GPL-2.0 OR MIT)
//
// ATK-IMX6U 最小系統 Device Tree
// 僅啟用：UART、eMMC、乙太網（ENET2）
// 基底：NXP i.MX6ULL 14x14 EVK + 硬體接線文件
//
// 學習筆記：
//   &label {}  = 覆蓋或擴充 dtsi 中已定義的節點
//   status     = "okay" 啟用，"disabled" 停用
//   pinctrl-0  = 指向此裝置使用的腳位配置群組

/dts-v1/;

#include "imx6ull.dtsi"
#include "imx6ul-14x14-evk.dtsi"
#include "imx6ull-pinfunc-snvs.h"

/ {
	model = "ATK-IMX6U Board";
	compatible = "fsl,imx6ull-14x14-evk", "fsl,imx6ull";

	chosen {
		stdout-path = &uart1;
	};

	sound {
		compatible = "fsl,imx6ul-evk-wm8960", "fsl,imx-audio-wm8960";
		model = "atk-wm8960";
		audio-cpu = <&sai2>;
		audio-codec = <&codec_atk>;
		audio-asrc = <&asrc>;
		hp-det-gpio = <&gpio5 4 0>;
		audio-routing =
			"Headphone Jack", "HP_L",
			"Headphone Jack", "HP_R",
			"Ext Spk", "SPK_LP",
			"Ext Spk", "SPK_LN",
			"Ext Spk", "SPK_RP",
			"Ext Spk", "SPK_RN",
			"LINPUT2", "Mic Jack",
			"LINPUT1", "Mic Jack",
			"RINPUT1", "AMIC",
			"RINPUT2", "AMIC",
			"LINPUT3", "AMIC",
			"Mic Jack", "MICB",
			"AMIC", "MICB";
	};
};

/* 序列埠（UART1 / ttymxc0 / COM7） */
&uart1 {
	status = "okay";
};

/* eMMC（usdhc2 = mmcblk1） */
&usdhc2 {
	status = "okay";
	non-removable;
};

/* UART2（ttymxc1）：移除 RTS/CTS 以釋放腳位給 UART3 */
&uart2 {
	/delete-property/ uart-has-rtscts;
};

/* UART3（ttymxc2）：TP8485E RS-485 */
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	/delete-property/ dmas;
	/delete-property/ dma-names;
	status = "okay";
};

/* ─────────── 乙太網 ─────────── */
// 基底以 imx6ul-14x14-evk.dtsi 為準，此處僅補上差異：
//   fec1（2188000 = ENET2）→ ethphy0（reg=2）
//   fec2（20b4000 = ENET1）→ ethphy1（reg=1）
//
// 原理圖（底板 J2）PHY reset 對應：
//   J2_9  = SNVS_TAMPER8 (GPIO5_IO08) = ENET2_RST → fec1 (ENET2)
//   J2_10 = SNVS_TAMPER7 (GPIO5_IO07) = ENET1_RST → fec2 (ENET1)

&fec1 {
	phy-reset-gpios = <&gpio5 8 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <200>;
};

&fec2 {
	phy-reset-gpios = <&gpio5 7 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <200>;
};

/* 將 PHY 型號從 KSZ8081 改為 SR8201F */
&ethphy0 {
	compatible = "ethernet-phy-id0011.0140";
};

&ethphy1 {
	compatible = "ethernet-phy-id0011.0140";
};

/* SNVS 腳位控制器：定義 PHY reset 腳位的 GPIO 模式 + 音訊 hp-detect */
&iomuxc_snvs {
	pinctrl_fec1_reset: fec1_resetgrp {
		fsl,pins = <MX6ULL_PAD_SNVS_TAMPER8__GPIO5_IO08 0x79>;
	};

	pinctrl_fec2_reset: fec2_resetgrp {
		fsl,pins = <MX6ULL_PAD_SNVS_TAMPER7__GPIO5_IO07 0x79>;
	};

	pinctrl_sai2_hp_det_b: sai2_hp_det_grp {
		fsl,pins = <
			MX6ULL_PAD_SNVS_TAMPER4__GPIO5_IO04	0x17059
		>;
	};
};

/* 關閉 spi-4（bitbang SPI），它佔用了 PHY reset 用的 GPIO5_IO07/IO08 */
&{/spi-4} {
	status = "disabled";
};

/* IOMUX：UART2（移除 RTS/CTS 腳位）+ UART3 + SAI2（音訊）+ I2C1 腳位配置 */
&iomuxc {
	pinctrl_uart2: uart2grp {
		fsl,pins = <
			MX6UL_PAD_UART2_TX_DATA__UART2_DCE_TX	0x1b0b1
			MX6UL_PAD_UART2_RX_DATA__UART2_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_uart3: uart3grp {
		fsl,pins = <
			MX6UL_PAD_UART3_TX_DATA__UART3_DCE_TX	0x1b0b1
			MX6UL_PAD_UART3_RX_DATA__UART3_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_sai2: sai2grp {
		fsl,pins = <
			MX6UL_PAD_JTAG_TDI__SAI2_TX_BCLK	0x17088
			MX6UL_PAD_JTAG_TDO__SAI2_TX_SYNC	0x17088
			MX6UL_PAD_JTAG_TRST_B__SAI2_TX_DATA	0x11088
			MX6UL_PAD_JTAG_TCK__SAI2_RX_DATA	0x11088
			MX6UL_PAD_JTAG_TMS__SAI2_MCLK		0x17088
		>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <
			MX6UL_PAD_UART4_TX_DATA__I2C1_SCL	0x4001b8b0
			MX6UL_PAD_UART4_RX_DATA__I2C1_SDA	0x4001b8b0
		>;
	};
};

/* ─────────── 音訊（WM8960）─────────── */
// WM8960G（底板 U13）：
//   SAI2：MCLK=P14、BCLK=N16、DACLRC=N15、DACDAT=N14、ADCDAT=M14（JTAG 複用）
//   I2C1：SCLK=G17、SDIN=G16（UART4 複用），位址 0x1A
//   AUD_INT：ADCLRC/GPIO1 → SNVS_TAMPER4 (GPIO5_IO04)，ALRCGPIO=1（wlf,shared-lrclk）

&sai2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sai2
		     &pinctrl_sai2_hp_det_b>;

	assigned-clocks = <&clks IMX6UL_CLK_SAI2_SEL>,
			  <&clks IMX6UL_CLK_SAI2>;
	assigned-clock-parents = <&clks IMX6UL_CLK_PLL4_AUDIO_DIV>;
	assigned-clock-rates = <0>, <12288000>;
	fsl,sai-mclk-direction-output;
	status = "okay";
};

&i2c1 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1>;
	status = "okay";

	codec_atk: wm8960@1a {
		compatible = "wlf,wm8960";
		reg = <0x1a>;
		clocks = <&clks IMX6UL_CLK_SAI2>;
		clock-names = "mclk";
		wlf,shared-lrclk;
		wlf,hp-cfg = <3 2 3>;
		wlf,gpio-cfg = <1 3>;
	};
};

&asrc {
	status = "okay";
};

/* 官方 dtsi 的 codec 在 i2c2（本板未接 WM8960）→ 禁用避免誤 probe */
&codec {
	status = "disabled";
};
