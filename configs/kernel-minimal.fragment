# === KEEP: Essential for boot ===
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_MMC_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_CLK_IMX6UL=y
CONFIG_PINCTRL_IMX6UL=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

